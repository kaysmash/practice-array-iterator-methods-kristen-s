let fruits = ["apple", "banana", "cherry"];
fruits.push("orange");
console.log(fruits); // Output: ["apple", "banana", "cherry", "orange"]
fruits.shift();
console.log(fruits); // Output: ["banana", "cherry", "orange"]  
fruits.unshift("grape");
console.log(fruits); // Output: ["grape", "banana", "cherry", "orange"]

let colors = ["red", "blue", "green", "blue", "yellow"];
colors.includes("blue"); // Output: true
colors.indexOf("blue", 0); // Output: 1
colors.lastIndexOf("blue"); // Output: 3
let results = [colors.includes("blue"), colors.indexOf("blue", 0), colors.lastIndexOf("blue")];
console.log(results); // Output: [true, 1, 3]

let teamA = ["Alice", "Bob"];
let teamB = ["Charlie", "Diana"]; 
let allTeams = teamA.concat(teamB);
console.log(allTeams); // Output: ["Alice", "Bob", "Charlie", "Diana"]
let allTeamsWithEve = teamA.concat(teamB, "Eve");
console.log(allTeamsWithEve); // Output: ["Alice", "Bob", "Charlie", "Diana", "Eve"]

let numbers = [10, 20, 30, 40, 50];
let middleNumbers = numbers.slice(1, 3);
console.log(middleNumbers); // Output: [20, 30]
numbers.splice(3, 2, 60, 70);
console.log(numbers);   // Output: [10, 20, 30, 60, 70]

let scores = [85, 70, 95, 60, 75];
scores.sort((a, b) => a - b);
console.log(scores); // Output: [60, 70, 75, 85, 95]
scores.reverse();
console.log(scores); // Output: [95, 85, 75, 70, 60]
scores.sort((a, b) => b - a);
console.log(scores); // Output: [95, 85, 75, 70, 60]
